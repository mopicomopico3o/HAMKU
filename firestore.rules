rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 각자 자기 자리(users/<본인 uid>/...)만 읽고 쓸 수 있고,
    // 아래 목록에 있는 구글 계정만 쓸 수 있습니다. 이메일을 실제 주소로 바꿔 주세요.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email in ['여자친구@gmail.com', 'juno@gmail.com'];
    }
  }
}
